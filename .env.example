# Copier ce fichier en .env.local et le remplir avec le projet MAXreport-dev
# (jamais la production en local).
# Valeurs : Supabase > Project Settings > API Keys (clé « publishable »).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Assistant IA (facultatif, côté serveur uniquement : jamais de préfixe NEXT_PUBLIC_).
# Sans clé, l'assistant est hors service. Voir docs/mise-en-production.md, §4.
# ANTHROPIC_API_KEY=
# ASSISTANT_DAILY_LIMIT=50
